# ─────────────────────────────────────────────────────────────
#  WoW Classic Plus LK — site configuration (copy to .env.local)
#  Every value here is optional. Defaults live in src/config/site.js
# ─────────────────────────────────────────────────────────────

# Public URL of the site (used to build links inside e-mails and SEO tags)
VITE_SITE_URL=https://wowclassicpluslk.com

# Abra API (queue + e-mail)
VITE_ABRA_API_URL=https://abra-api.top
# REQUIRED for `npm run build` — keep the real values only in .env (git-ignored).
# Queue key your server polls to create AzerothCore accounts
VITE_QUEUE_REGISTRATION_KEY=
# Queue key for every other event (password recovery, download alerts)
VITE_QUEUE_EVENTS_KEY=

# Optional but STRONGLY recommended: RSA public key (base64 SPKI, no PEM headers)
# Generate with:  npm run queue:keygen
# When set, every queued payload is encrypted (RSA-OAEP-256 + AES-256-GCM)
VITE_QUEUE_PUBLIC_KEY=

# Realm
VITE_REALM_NAME=Classic Plus LK
VITE_REALM_STATUS=online           # online | offline | maintenance
# What players put in realmlist.wtf (shown with a copy button in "Play Now")
VITE_REALMLIST=
VITE_REALM_REGION=Global
VITE_REALM_LATENCY_MS=31
# Optional JSON endpoint: { "online": true, "playersOnline": 120, "totalAccounts": 4210 }
VITE_STATUS_URL=

# Downloads / launcher: coming-soon | early-access | available
VITE_DOWNLOAD_32_STATUS=coming-soon
VITE_DOWNLOAD_64_STATUS=coming-soon
VITE_DOWNLOAD_32_URL=
VITE_DOWNLOAD_64_URL=
VITE_LAUNCHER_STATUS=coming-soon
VITE_LAUNCHER_URL=

# Login API (Pikachu). Empty = the login page says web login is unavailable.
VITE_AUTH_API_URL=https://bush-wifi-wanting.ngrok-free.dev/launcher/v1

# Optional voluntary-support page (Ko-fi, Patreon...). Empty = "coming soon".
VITE_SUPPORT_URL=
